#!/usr/bin/env python3
"""
`octo` — Distributed Multi-Agent GitHub Kanban & Multi-Harness Orchestrator CLI.
Zero external dependencies required. Works across macOS & Linux worker nodes.
"""

import argparse
import json
import sys
import time
from pathlib import Path

# Add repo root to sys.path
REPO_ROOT = Path(__file__).resolve().parent.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from orchestrator.cluster_ssh import ClusterSSHManager
from orchestrator.config import find_repo_root, get_node_identity, list_agent_specs, load_config, load_yaml_file
from orchestrator.dag_planner import DAGPlanner
from orchestrator.github_bus import GitHubBus, GitHubBusError
from orchestrator.harness_runner import HarnessRunner
from orchestrator.qa_auditor import QAAuditor
from orchestrator.worker_daemon import WorkerDaemon
from orchestrator.swarm_board import SwarmBoard
from orchestrator.overlap_detector import OverlapDetector
from orchestrator.c2c_coordinator import C2CCoordinator


def build_context(args: argparse.Namespace):
    workdir = getattr(args, "workdir", None)
    start = Path(workdir).resolve() if workdir else Path.cwd()
    root = find_repo_root(start)
    config = load_config(root)
    if not config:
        config = load_config(REPO_ROOT)
    mock_dir = Path(args.mock_dir) if getattr(args, "mock_dir", None) else None
    bus = GitHubBus(repo=getattr(args, "repo", None), config=config, mock_dir=mock_dir, cwd=root)
    runner = HarnessRunner(config=config, repo_root=root)
    return root, config, bus, runner


def _scaffold_repo(root: Path) -> list[str]:
    """Creates starter Octo folders & files in `root` without overwriting existing ones."""
    import shutil

    scaffolded = []
    for rel in ("docs/inputs", "docs/plans", ".swarm", "agents"):
        d = root / rel
        if not d.exists():
            d.mkdir(parents=True, exist_ok=True)
            scaffolded.append(f"{rel}/")
        keep = d / ".gitkeep"
        if rel in ("docs/inputs", "docs/plans", ".swarm") and not any(d.iterdir()):
            keep.touch()

    if not (root / "orchestrator.yaml").exists() and (REPO_ROOT / "orchestrator.yaml").exists():
        shutil.copy2(REPO_ROOT / "orchestrator.yaml", root / "orchestrator.yaml")
        scaffolded.append("orchestrator.yaml")

    template_agents = REPO_ROOT / "agents"
    if template_agents.exists():
        for src in sorted(template_agents.glob("*.md")):
            dst = root / "agents" / src.name
            if not dst.exists():
                shutil.copy2(src, dst)
                scaffolded.append(f"agents/{src.name}")

    gitignore_path = root / ".gitignore"
    required_entries = [
        ".worktrees/",
        ".octo-sessions/",
        "orchestrator.local.yaml",
        "agents/*.local.md",
        ".swarm/*",
        "!.swarm/.gitkeep",
    ]
    existing_gi = gitignore_path.read_text(encoding="utf-8") if gitignore_path.exists() else ""
    missing_gi = [e for e in required_entries if e not in existing_gi]
    if missing_gi:
        block = ("\n" if existing_gi and not existing_gi.endswith("\n") else "") + "# Octo runtime & local overrides\n" + "\n".join(missing_gi) + "\n"
        gitignore_path.write_text(existing_gi + block, encoding="utf-8")
        scaffolded.append(".gitignore (Octo rules)")

    return scaffolded


def cmd_init(args: argparse.Namespace) -> int:
    workdir = getattr(args, "workdir", None)
    target_dir = Path(workdir).resolve() if workdir else find_repo_root()
    scaffolded = _scaffold_repo(target_dir)
    if scaffolded:
        print(f"📁 Scaffolded Octo workspace in `{target_dir}`:")
        for item in scaffolded:
            print(f"   • {item}")

    root, config, bus, _ = build_context(args)
    created = bus.bootstrap_labels()
    print(f"✅ Bootstrapped {len(created)} Kanban labels on GitHub ({bus.repo or root.name}):")
    for lbl in created:
        print(f"   • {lbl}")
    board = SwarmBoard(repo_root=root, bus=bus)
    issue_num = board.get_or_create_github_issue()
    if issue_num:
        print(f"🐝 Initialized GitHub-hosted Swarm Message Board on Issue #{issue_num}")
    if config.get("kanban", {}).get("sync_github_project", True):
        try:
            proj_res = bus.sync_all_issues_to_project()
            print(
                f"📊 Synced GitHub Project #{proj_res['project_number']} ({proj_res['project_title']}): "
                f"{proj_res['synced_count']}/{proj_res['total_issues']} issues"
            )
            if proj_res.get("project_url"):
                print(f"   • {proj_res['project_url']}")
        except GitHubBusError as exc:
            print(f"ℹ️  GitHub Projects v2 sync skipped: {exc}")
    return 0


def cmd_agents(args: argparse.Namespace) -> int:
    root, config, _, runner = build_context(args)
    planning_cfg = config.get("planning", {})
    rounds = planning_cfg.get("rounds", 2)

    print("=" * 78)
    print("🤖 CONFIGURED AGENTS & ACTIVE PIPELINE (Octo Orchestrator)")
    print("=" * 78)
    print("Active Pipeline:")
    for role in ("explorer", "architect", "critic", "worker", "qa"):
        try:
            info = runner.describe_target(role)
            ep = f" @ {info['endpoint']}" if info["endpoint"] else ""
            th = f" [thinking={info['thinking']}]" if info["thinking"] else ""
            print(
                f"  • {role:<10} -> {info['name']:<18} | harness={info['adapter']:<7} | "
                f"model={info['model_id']}{th}{ep} ({info['source']})"
            )
        except ValueError as e:
            print(f"  • {role:<10} -> (unconfigured: {e})")
    print(f"  • planning.rounds = {rounds} (1 = single-pass, 2+ = Architect <-> Critic refinement)")

    specs = list_agent_specs(root, config)
    if specs:
        print("\nAgent Definitions (`agents/*.md` & `orchestrator.yaml`):")
        for name, spec in specs.items():
            info = runner.describe_target(name)
            desc = f" — {spec.description}" if spec.description else ""
            print(f"  • {name:<18} [{info['adapter']}:{info['model_id']}]{desc}")

    profiles = config.get("harnesses", {}).get("profiles", {})
    if profiles:
        print("\nHarness Profiles (`orchestrator.yaml:harnesses.profiles`):")
        for pname in profiles:
            info = runner.describe_target(pname)
            ep = f" ({info['endpoint']})" if info["endpoint"] else ""
            print(f"  • {pname:<18} [{info['adapter']}:{info['model_id']}]{ep}")

    print("\nTip: Override any run via `--agent <name>`, `--profile <name>`, or `--model <model>`.")
    print("     Keep private IPs/models out of git using `orchestrator.local.yaml` or `agents/*.local.md`.")
    print("=" * 78)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    _, _, bus, _ = build_context(args)
    issues = bus.list_issues(state="all", limit=200)
    if not issues:
        print("📭 Kanban board is currently empty.")
        return 0

    columns = [
        "status:awaiting-approval",
        "status:planning",
        "status:blocked",
        "status:ready",
        "status:in-progress",
        "status:needs-clarification",
        "status:in-review",
        "status:rework",
        "status:done",
    ]
    grouped = {col: [] for col in columns}
    other = []

    for iss in issues:
        labels = [l["name"] for l in iss.get("labels", [])]
        matched = False
        for col in columns:
            if col in labels:
                grouped[col].append(iss)
                matched = True
                break
        if not matched:
            other.append(iss)

    print("=" * 78)
    print("📊 GITHUB MULTI-AGENT KANBAN BOARD (SSOT)")
    print("=" * 78)
    for col in columns:
        items = grouped[col]
        if not items and col in ("status:planning", "status:needs-clarification"):
            continue
        print(f"\n[{col.upper()}] ({len(items)})")
        for iss in items:
            labels = [l["name"] for l in iss.get("labels", [])]
            epic_tag = next((l for l in labels if l.startswith("epic:")), "")
            epic_str = f" [{epic_tag}]" if epic_tag else ""
            claim = bus.get_active_claim(iss)
            claim_str = (
                f" 🔒 {claim['node_id']} ({claim['harness']} -> exp {claim['lease_expires_at'][11:19]}Z)"
                if claim
                else ""
            )
            print(f"  #{iss['number']:<4} {iss['title']}{epic_str}{claim_str}")
    if other:
        print(f"\n[UNCLASSIFIED] ({len(other)})")
        for iss in other:
            print(f"  #{iss['number']:<4} {iss['title']}")
    print("=" * 78)
    return 0


def cmd_plan(args: argparse.Namespace) -> int:
    root, config, bus, runner = build_context(args)
    planner = DAGPlanner(bus=bus, runner=runner, repo_root=root, config=config)

    if args.from_file:
        plan_text = Path(args.from_file).read_text(encoding="utf-8")
        tasks = planner.parse_tasks_from_markdown(plan_text)
        trace = []
    else:
        arch_target = args.agent or args.profile or "architect"
        exp_target = args.explorer_agent or "explorer"
        crit_target = args.critic_agent or "critic"
        rounds = args.rounds if args.rounds is not None else int(config.get("planning", {}).get("rounds", 2))

        arch_info = runner.describe_target(arch_target, model_override=args.model)
        print("🧠 Orchestrating Multi-Agent Planning Pipeline:")
        if not args.no_explore:
            exp_info = runner.describe_target(exp_target, model_override=args.model)
            print(f"   • Step 1 Explorer  : {exp_info['name']} ({exp_info['adapter']}:{exp_info['model_id']})")
        print(f"   • Step 2 Architect : {arch_info['name']} ({arch_info['adapter']}:{arch_info['model_id']})")
        if rounds > 1:
            crit_info = runner.describe_target(crit_target, model_override=args.model)
            print(f"   • Step 3 Critic    : {crit_info['name']} ({crit_info['adapter']}:{crit_info['model_id']}) [rounds={rounds}]")

        plan_text, tasks = planner.generate_plan_with_harness(
            goal=args.goal,
            profile=arch_target,
            explorer_profile=exp_target,
            critic_profile=crit_target,
            model_override=args.model,
            rounds=rounds,
            skip_explore=args.no_explore,
            doc_paths=args.docs,
        )
        trace = planner.last_planning_trace

    epic_num = planner.create_epic_for_approval(
        goal_title=args.goal,
        plan_markdown=plan_text,
        tasks=tasks,
        planning_trace=trace,
    )
    print(f"📐 Created Master Epic Issue #{epic_num} in state `status:awaiting-approval`.")
    print(f"⏸️  HUMAN GATE: Review the plan on GitHub Issue #{epic_num} or `docs/plans/EPIC-{epic_num}.md`.")
    print(f"👉 Run `./bin/octo approve {epic_num}` (or comment `/approve` on Issue #{epic_num}) to spawn tasks!")
    return 0


def cmd_approve(args: argparse.Namespace) -> int:
    root, config, bus, runner = build_context(args)
    planner = DAGPlanner(bus=bus, runner=runner, repo_root=root, config=config)
    spawned = planner.approve_and_spawn_dag(args.epic_number)
    print(f"✅ Approved Epic #{args.epic_number}! Spawned {len(spawned)} Epic-tagged sub-issues (label `epic:{args.epic_number}`):")
    for tid, inum in spawned.items():
        print(f"   • E{args.epic_number}-{tid} -> Issue #{inum}")
    return 0


def cmd_worker(args: argparse.Namespace) -> int:
    root, config, bus, runner = build_context(args)
    target = args.agent or args.profile or "worker"
    daemon = WorkerDaemon(
        bus=bus,
        runner=runner,
        repo_root=root,
        config=config,
        node_id=args.node_id,
        profile_name=target,
        model_override=args.model,
        assignee=getattr(args, "assignee", None),
    )

    if args.once:
        processed = daemon.process_next_available_issue()
        if processed:
            print(f"✅ Worker `{daemon.node_id}` processed Issue #{processed}.")
        else:
            print(f"💤 No `status:ready` or `status:rework` issues available for `{daemon.node_id}`.")
        return 0

    info = runner.describe_target(target, model_override=args.model)
    print(f"🚀 Worker Daemon `{daemon.node_id}` (agent=`{info['name']}`, model=`{info['model_id']}`) listening on GitHub Kanban...")
    try:
        while True:
            processed = daemon.process_next_available_issue()
            if processed:
                print(f"✅ Processed Issue #{processed}.")
            time.sleep(args.poll_interval)
    except KeyboardInterrupt:
        print(f"\n👋 Worker `{daemon.node_id}` shutting down cleanly.")
        return 0


def cmd_qa(args: argparse.Namespace) -> int:
    root, config, bus, runner = build_context(args)
    target = args.agent or args.profile or "qa"
    auditor = QAAuditor(
        bus=bus,
        runner=runner,
        repo_root=root,
        config=config,
        node_id=args.node_id,
        qa_profile=target,
        model_override=args.model,
    )
    planner = DAGPlanner(bus=bus, runner=runner, repo_root=root, config=config)

    if args.issue:
        passed, _ = auditor.audit_issue_in_review(args.issue, run_llm_audit=not args.skip_llm)
        planner.reconcile_dag_and_unblock()
        print(f"🛡️  QA & Code Review for Issue #{args.issue}: {'PASSED ✅' if passed else 'FAILED ❌'}")
        return 0 if passed else 1

    results = auditor.process_all_in_review(run_llm_audit=not args.skip_llm)
    reconciled = planner.reconcile_dag_and_unblock()
    for inum, passed in results:
        print(f"🛡️  Issue #{inum}: {'PASSED ✅' if passed else 'CHANGES REQUESTED ❌'}")
    if reconciled["unblocked_tasks"]:
        print(f"🔓 Automatically unblocked downstream tasks: {reconciled['unblocked_tasks']}")
    if reconciled["completed_epics"]:
        print(f"🎉 Completed Epics: {reconciled['completed_epics']}")
    return 0


def cmd_orchestrate(args: argparse.Namespace) -> int:
    """
    Runs a full Orchestrator Control Loop pass:
    1. Reaps expired leases from offline nodes
    2. Audits any `status:in-review` PRs
    3. Reconciles DAG (checks `/approve` comments on Epics, unblocks `status:blocked` tasks)
    """
    root, config, bus, runner = build_context(args)
    planner = DAGPlanner(bus=bus, runner=runner, repo_root=root, config=config)
    worker = WorkerDaemon(bus=bus, runner=runner, repo_root=root, config=config, node_id=args.node_id)
    auditor = QAAuditor(bus=bus, runner=runner, repo_root=root, config=config, node_id=args.node_id)

    def _single_tick():
        reaped = worker.reap_stale_in_progress_issues()
        if reaped:
            print(f"⚠️  Reaped expired leases on issues: {reaped}")
        qa_res = auditor.process_all_in_review(run_llm_audit=not args.skip_llm)
        for inum, passed in qa_res:
            print(f"🛡️  QA audited Issue #{inum} -> {'PASS' if passed else 'REWORK'}")
        rec = planner.reconcile_dag_and_unblock()
        if any(rec.values()):
            print(f"🔄 DAG Reconciled: {json.dumps(rec)}")

    if args.once:
        _single_tick()
        return 0

    print("🧠 Orchestrator Control Loop started...")
    try:
        while True:
            _single_tick()
            time.sleep(args.poll_interval)
    except KeyboardInterrupt:
        print("\n👋 Orchestrator stopped.")
        return 0


def cmd_swarm(args: argparse.Namespace) -> int:
    root, _, bus, _ = build_context(args)
    board = SwarmBoard(repo_root=root, bus=bus)

    if args.swarm_action == "status":
        summary = board.get_summary()
        print("=" * 78)
        print("🐝 SWARM LIVE MESSAGE BOARD STATUS (100% Hosted on GitHub)")
        print("=" * 78)
        print(f"• Swarm ID:          {summary['swarm_id']}")
        if summary.get("github_issue"):
            print(f"• GitHub Issue SSOT: Issue #{summary['github_issue']} (https://github.com/{getattr(bus, 'repo', 'repo')}/issues/{summary['github_issue']})")
        print(f"• Total Messages:    {summary['total_messages']} (Latest Seq: #{summary['latest_seq']})")
        print(f"• Participants:      {', '.join(summary['participants']) or 'None yet'}")
        print(f"• Active Channels:   {', '.join(summary['channels'])}")
        print(f"• Completed Tasks:   {summary['completed_count']}")
        print(f"• Overlap Alerts:    {summary['overlap_alerts_count']}")
        print("\n--- Recent Board Posts ---")
        for m in summary["recent_messages"]:
            print(f"#{m['seq']:<4} [{m['channel']}] {m['sender']} -> {m['recipient']}: {m['text'][:80]}")
        print("=" * 78)
        return 0

    elif args.swarm_action == "post":
        msg = board.post(
            sender=args.sender or get_node_identity(),
            recipient=args.recipient,
            text=args.message,
            channel=args.channel,
        )
        gh_info = f" (Mirrored to GitHub Issue #{board._github_issue_number})" if board._github_issue_number else ""
        print(f"✅ Posted message #{msg.seq} to Swarm Board ({msg.channel}){gh_info}: {msg.sender} -> {msg.recipient}")
        return 0

    elif args.swarm_action == "board":
        sync_gh = not args.no_sync
        msgs = board.read(since_seq=args.since, channel=args.channel, sync_github=sync_gh)
        if not msgs:
            print("📭 Swarm board is quiet (no new messages).")
            return 0
        for m in msgs:
            print(f"#{m.seq:<4} [{m.channel}] {m.sender} -> {m.recipient}: {m.text}")
        return 0

    return 1


def cmd_overlap(args: argparse.Namespace) -> int:
    root, _, bus, _ = build_context(args)
    detector = OverlapDetector(repo_root=root)
    active_issues = bus.list_issues(label="status:in-progress", state="open") + bus.list_issues(
        label="status:ready", state="open"
    ) + bus.list_issues(label="status:in-review", state="open")

    active_tasks = [i for i in active_issues if "type:epic" not in [l["name"] for l in i.get("labels", [])]]
    reports = detector.check_overlaps(active_tasks)

    print("=" * 78)
    print("🔍 MULTIPLAYER OVERLAP & CONFLICT RADAR")
    print("=" * 78)
    if not reports:
        print("✅ Clean: Zero code collisions or interface dependencies detected across active tasks.")
        print("=" * 78)
        return 0

    for r in reports:
        badge = "🚨 [CRITICAL COLLISION]" if r.level == "CRITICAL_COLLISION" else "⚠️ [INTERFACE DEPENDENCY]" if r.level == "INTERFACE_DEPENDENCY" else "ℹ️ [PACKAGE PROXIMITY]"
        print(f"\n{badge}")
        print(f"• Description: {r.message}")
        print(f"• Tasks:       {', '.join(f'#{t}' for t in r.conflicting_tasks)}")
        print(f"• Files:       {', '.join(f'`{f}`' for f in r.conflicting_files)}")
        print(f"• Action:      {r.suggested_action}")
    print("=" * 78)
    return 0


def cmd_c2c(args: argparse.Namespace) -> int:
    root, _, bus, _ = build_context(args)
    board = SwarmBoard(repo_root=root)
    c2c = C2CCoordinator(repo_root=root, bus=bus, board=board)

    if args.c2c_action == "list":
        coordinators = c2c.list_active_coordinators()
        print("=" * 78)
        print("🌐 ACTIVE COORDINATORS IN MULTIPLAYER SWARM")
        print("=" * 78)
        if not coordinators:
            print("No external coordinators registered yet.")
        for c in coordinators:
            epic_str = f"Epic #{c.active_epic} ({c.goal_title})" if c.active_epic else "Idle"
            print(f"• {c.coordinator_id:<25} Node: {c.node_id:<15} Active: {epic_str}")
        print("=" * 78)
        return 0

    elif args.c2c_action == "send":
        msg = c2c.send_message(
            target_coordinator=args.target,
            kind=args.kind,
            subject=args.subject or "C2C Coordination",
            body=args.message,
            metadata={"epic_number": args.epic},
        )
        print(f"✅ Sent C2C Message [{msg.kind}] to {msg.target_coordinator}: {msg.subject}")
        return 0

    elif args.c2c_action == "negotiate":
        detector = OverlapDetector(repo_root=root)
        active_issues = bus.list_issues(label="status:in-progress", state="open") + bus.list_issues(
            label="status:ready", state="open"
        )
        active_tasks = [i for i in active_issues if "type:epic" not in [l["name"] for l in i.get("labels", [])]]
        sent = c2c.auto_negotiate_overlaps(detector, active_tasks)
        print(f"🤝 C2C Auto-Negotiation complete: {len(sent)} collision heads-up messages sent to peer coordinators.")
        return 0

    return 1


def cmd_node(args: argparse.Namespace) -> int:
    _, config, _, _ = build_context(args)
    mgr = ClusterSSHManager(config)

    if args.node_action == "list":
        for name, spec in mgr.list_configured_nodes().items():
            if args.probe:
                info = mgr.probe_node(name)
                status = "🟢 ONLINE" if info.get("online") else f"🔴 OFFLINE ({info.get('error')})"
                tools = ", ".join(k for k, v in info.get("tools", {}).items() if v)
                print(f"• {name:<15} ({spec.get('host')}) -> {status} | Tools: [{tools}] | Active workers: {len(info.get('workers', []))}")
            else:
                print(f"• {name:<15} host={spec.get('host'):<15} default_profile={spec.get('default_profile')} roles={spec.get('roles')}")
        return 0

    elif args.node_action == "add":
        ok, out = mgr.start_remote_worker(
            node_name=args.name,
            repo_url=args.repo_url or "",
            profile=args.profile,
            dry_run=args.dry_run,
        )
        print(out)
        return 0 if ok else 1

    elif args.node_action == "remove":
        ok, out = mgr.stop_remote_worker(node_name=args.name, dry_run=args.dry_run)
        print(out)
        return 0 if ok else 1

    return 1


def _save_local_project_binding(root: Path, project_number: int, owner: str = "") -> None:
    local_path = root / "orchestrator.local.yaml"
    existing = load_yaml_file(local_path)
    kanban = dict(existing.get("kanban", {}))
    kanban["project_number"] = int(project_number)
    kanban["sync_github_project"] = True
    if owner:
        kanban["project_owner"] = owner
    existing["kanban"] = kanban
    try:
        import yaml  # type: ignore
        local_path.write_text(yaml.safe_dump(existing, sort_keys=False), encoding="utf-8")
    except ImportError:
        local_path.write_text(
            f"kanban:\n  project_number: {int(project_number)}\n  sync_github_project: true\n"
            + (f"  project_owner: \"{owner}\"\n" if owner else ""),
            encoding="utf-8",
        )


def cmd_project(args: argparse.Namespace) -> int:
    root, config, bus, _ = build_context(args)
    owner = getattr(args, "owner", None)

    try:
        if args.project_action == "status":
            projects = bus.list_github_projects(owner=owner)
            print("=" * 78)
            print(f"📊 GITHUB PROJECTS v2 (Repo: {bus.repo or root.name})")
            print("=" * 78)
            if not projects:
                print("No GitHub Projects found for this owner.")
            for p in projects:
                print(f"  #{p.get('number'):<4} {p.get('title')} -> {p.get('url', '')}")
            active = bus.ensure_github_project(owner=owner, create_if_missing=False)
            if active:
                cols = ", ".join(active.get("status_options", {}).keys()) or "(none)"
                print(f"\nActive Binding: Project #{active['number']} ({active['title']}) | Columns: [{cols}]")
            else:
                print("\nNo Project matched `kanban.project_number` / `kanban.project_title` yet.")
            print("=" * 78)
            return 0

        elif args.project_action == "init":
            res = bus.sync_all_issues_to_project(project_number=args.number, title=args.title)
            print(
                f"✅ GitHub Project #{res['project_number']} ({res['project_title']}) ready & synced "
                f"({res['synced_count']}/{res['total_issues']} issues)"
            )
            if res.get("project_url"):
                print(f"🔗 {res['project_url']}")
            return 0

        elif args.project_action == "sync":
            res = bus.sync_all_issues_to_project(project_number=args.number)
            print(
                f"🔄 Synced {res['synced_count']}/{res['total_issues']} issues to GitHub Project "
                f"#{res['project_number']} ({res['project_title']})"
            )
            return 0

        elif args.project_action == "link":
            if not args.number:
                print("❌ Specify the GitHub Project number: ./bin/octo project link <number>")
                return 1
            _save_local_project_binding(root, args.number, owner=owner or "")
            res = bus.sync_all_issues_to_project(project_number=args.number)
            print(
                f"✅ Bound `orchestrator.local.yaml` -> GitHub Project #{res['project_number']} ({res['project_title']}) "
                f"and synced {res['synced_count']}/{res['total_issues']} issues."
            )
            return 0
    except GitHubBusError as exc:
        print(f"❌ {exc}")
        return 1

    return 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="octo",
        description="Distributed Multi-Agent GitHub Kanban & Multi-Harness Orchestrator",
    )
    p.add_argument("-C", "--workdir", help="Target repository directory (defaults to current working directory).")
    p.add_argument("-R", "--repo", help="GitHub repository (OWNER/REPO). Defaults to current git remote.")
    p.add_argument("--mock-dir", help="Local directory for offline/mock GitHub simulation.")

    sub = p.add_subparsers(dest="command", required=True)

    # init
    sub_init = sub.add_parser("init", help="Bootstrap GitHub Kanban labels and Swarm Board issue")
    sub_init.set_defaults(func=cmd_init)

    # agents
    sub_agents = sub.add_parser("agents", help="Show configured agents, models, and active planning/execution pipeline")
    sub_agents.set_defaults(func=cmd_agents)

    # status
    sub_status = sub.add_parser("status", help="Show live GitHub Kanban board and active worker leases")
    sub_status.set_defaults(func=cmd_status)

    # project
    sub_proj = sub.add_parser("project", help="Inspect, link, and sync GitHub Projects v2 board")
    sub_proj.add_argument("project_action", choices=["status", "init", "sync", "link"], help="Project action")
    sub_proj.add_argument("number", nargs="?", type=int, help="GitHub Project number (for link/init/sync)")
    sub_proj.add_argument("--title", help="Project title when initializing")
    sub_proj.add_argument("--owner", help="GitHub user/org owning the Project (defaults to repo owner)")
    sub_proj.set_defaults(func=cmd_project)

    # plan
    sub_plan = sub.add_parser("plan", help="Phase 1: Orchestrate planning agents to build an Epic RFC & Task DAG")
    sub_plan.add_argument("goal", help="High-level goal or feature title")
    sub_plan.add_argument("--agent", help="Override Architect agent (default: planning.agents.architect)")
    sub_plan.add_argument("--explorer-agent", help="Override Explorer agent (default: planning.agents.explorer)")
    sub_plan.add_argument("--critic-agent", help="Override Critic agent (default: planning.agents.critic)")
    sub_plan.add_argument("--profile", help="Override harness profile (e.g. claude-cli, pi-local)")
    sub_plan.add_argument("--model", help="Override model for the planning agents (e.g. opus, sonnet, qwen2.5-coder)")
    sub_plan.add_argument("--rounds", type=int, default=None, help="Planning refinement rounds (1=fast, 2+=Architect<->Critic loop)")
    sub_plan.add_argument("--no-explore", action="store_true", help="Skip the Explorer codebase discovery step")
    sub_plan.add_argument("--docs", nargs="*", help="Input document paths (defaults to all files in docs/inputs/)")
    sub_plan.add_argument("--from-file", help="Load pre-written Markdown/JSON plan file instead of invoking agents")
    sub_plan.set_defaults(func=cmd_plan)

    # approve
    sub_app = sub.add_parser("approve", help="Phase 2: Approve an Epic (`status:awaiting-approval`) and spawn Epic-tagged tasks")
    sub_app.add_argument("epic_number", type=int, help="Master Epic Issue number to approve")
    sub_app.set_defaults(func=cmd_approve)

    # worker
    sub_wrk = sub.add_parser("worker", help="Run a Worker Node that claims and implements `status:ready` issues")
    sub_wrk.add_argument("--node-id", default=None, help="Unique node identifier (defaults to hostname)")
    sub_wrk.add_argument("--agent", help="Worker agent name (default: worker)")
    sub_wrk.add_argument("--profile", default="worker", help="Harness profile fallback (e.g. claude-cli, pi-local)")
    sub_wrk.add_argument("--model", help="Override model for this worker run")
    sub_wrk.add_argument("--assignee", help="Only claim issues assigned to this GitHub login (multi-user safety)")
    sub_wrk.add_argument("--once", action="store_true", help="Claim and process at most one issue then exit")
    sub_wrk.add_argument("--loop", action="store_true", help="Continuously poll for ready issues")
    sub_wrk.add_argument("--poll-interval", type=int, default=15, help="Seconds between polls in loop mode")
    sub_wrk.set_defaults(func=cmd_worker)

    # qa
    sub_qa = sub.add_parser("qa", help="Run Integrated QA & Code Review on `status:in-review` issues")
    sub_qa.add_argument("--issue", type=int, help="Audit a specific issue number")
    sub_qa.add_argument("--node-id", default=None, help="Auditor node identifier")
    sub_qa.add_argument("--agent", help="QA agent name (default: qa)")
    sub_qa.add_argument("--profile", default="qa", help="QA harness profile fallback")
    sub_qa.add_argument("--model", help="Override model for QA review")
    sub_qa.add_argument("--skip-llm", action="store_true", help="Run only deterministic verification & static safety checks")
    sub_qa.set_defaults(func=cmd_qa)

    # orchestrate
    sub_orch = sub.add_parser("orchestrate", help="Run the Orchestrator Control Loop (DAG unblocking, lease reaping, QA gate)")
    sub_orch.add_argument("--node-id", default="orchestrator-main", help="Orchestrator node ID")
    sub_orch.add_argument("--once", action="store_true", help="Run a single reconciliation pass and exit")
    sub_orch.add_argument("--poll-interval", type=int, default=15, help="Poll interval in seconds")
    sub_orch.add_argument("--skip-llm", action="store_true", help="Use deterministic QA checks in control loop")
    sub_orch.set_defaults(func=cmd_orchestrate)

    # node
    sub_node = sub.add_parser("node", help="Manage hot-plug remote worker nodes over SSH")
    sub_node.add_argument("node_action", choices=["list", "add", "remove"], help="Node action")
    sub_node.add_argument("name", nargs="?", help="Node name from orchestrator.yaml (e.g. localhost, gpu-worker-1)")
    sub_node.add_argument("--probe", action="store_true", help="Probe SSH connectivity and installed harnesses")
    sub_node.add_argument("--profile", help="Override harness profile for remote worker")
    sub_node.add_argument("--repo-url", help="Git repository URL for remote clone")
    sub_node.add_argument("--dry-run", action="store_true", help="Print SSH command without executing")
    sub_node.set_defaults(func=cmd_node)

    # swarm
    sub_swm = sub.add_parser("swarm", help="Inspect and interact with the live Swarm Message Board")
    sub_swm.add_argument("swarm_action", choices=["status", "post", "board"], help="Swarm action")
    sub_swm.add_argument("recipient", nargs="?", default="@all", help="Target agent (@parser, @verifier, @all, or @#channel)")
    sub_swm.add_argument("message", nargs="?", default="", help="Message text")
    sub_swm.add_argument("--channel", default="main", help="Channel name (default: main)")
    sub_swm.add_argument("--since", type=int, default=0, help="Read messages after this sequence number")
    sub_swm.add_argument("--sender", help="Sender agent name (defaults to current node)")
    sub_swm.add_argument("--no-sync", action="store_true", help="Read only from local cache without polling GitHub")
    sub_swm.set_defaults(func=cmd_swarm)

    # overlap
    sub_ovr = sub.add_parser("overlap", help="Scan active tasks and worktrees for code collisions and interface dependencies")
    sub_ovr.set_defaults(func=cmd_overlap)

    # c2c
    sub_c2c = sub.add_parser("c2c", help="Coordinator-to-Coordinator cross-assignment peer protocol")
    sub_c2c.add_argument("c2c_action", choices=["list", "send", "negotiate"], help="C2C action")
    sub_c2c.add_argument("target", nargs="?", default="@coordinators", help="Target coordinator ID or @coordinators")
    sub_c2c.add_argument("message", nargs="?", default="", help="C2C message content")
    sub_c2c.add_argument("--subject", help="Message subject")
    sub_c2c.add_argument("--kind", default="HEADS_UP", choices=["PLAN_SHARE", "HEADS_UP", "LOCK_REQUEST", "CONTRACT_SYNC", "RESOLVE"], help="Message category")
    sub_c2c.add_argument("--epic", type=int, help="Associated Epic issue number")
    sub_c2c.set_defaults(func=cmd_c2c)

    return p


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
